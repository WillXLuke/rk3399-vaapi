 void request_log(const char *format, ...)
 {
+	static int enabled = -1;
 	va_list arguments;
 
+	/*
+	 * The backend is chatty (per-frame control dumps, pool setup).  Stay
+	 * quiet by default so applications do not get a log flood on stderr;
+	 * set LIBVA_V4L2_REQUEST_DEBUG=1 to get the diagnostics back.
+	 */
+	if (enabled < 0)
+		enabled = getenv("LIBVA_V4L2_REQUEST_DEBUG") != NULL;
+	if (!enabled)
+		return;
+
 	fprintf(stderr, "%s: ", V4L2_REQUEST_STR_VENDOR);
 
 	va_start(arguments, format);
